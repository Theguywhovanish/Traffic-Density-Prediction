# Optional overrides for the Docker Compose PEMS04 demonstration
# REPLAY_TICKS applies when REPLAY_LOOP is false.
REPLAY_TICKS=60
# Wall-clock seconds for each simulated five-minute sensor tick.
REPLAY_DELAY=2
REPLAY_START_STEP=auto
REPLAY_LOOP=true
# -1 disables the synthetic incident scenario
SCENARIO_TICK=-1
SCENARIO_DURATION=6
SCENARIO_SENSORS=0,100,200
